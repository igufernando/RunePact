# Text files are normalized to LF for consistent diffs across platforms.
# Arquivos de texto usam LF para diffs consistentes entre plataformas.
* text=auto eol=lf

# Unity scenes and settings remain text-mergeable.
# Cenas e configurações Unity permanecem mescláveis como texto.
*.unity text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf

# Generated game art is binary.
# Arte gerada do jogo é binária.
*.png binary
